{
  "name": "terrain-builder-backend",
  "version": "1.0.0",
  "description": "Backend API for Terrain Builder - 3D terrain marketplace",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec \"ts-node -r dotenv/config src/index.ts\"",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:prod": "node dist/index.js",
    "migrate": "node -r ts-node/register scripts/migrate.ts",
    "postmigrate": "node -r ts-node/register/transpile-only scripts/seed-taxonomy.ts || echo \"taxonomy seed skipped (non-fatal)\"",
    "migrate:rollback": "node -r ts-node/register scripts/rollback.ts",
    "migrate:status": "node -r ts-node/register scripts/migrate-status.ts",
    "migrate:models-to-assets": "node -r ts-node/register scripts/migrate-models-to-assets.ts",
    "upload:r2": "node -r ts-node/register scripts/upload-to-r2.ts",
    "optimize:textures": "node -r ts-node/register/transpile-only scripts/optimize-textures.ts",
    "trace:watermark": "node -r ts-node/register/transpile-only scripts/trace-watermark.ts",
    "test:stage4": "node -r ts-node/register/transpile-only scripts/test-stage4-e2e.ts",
    "test:terrain": "node -r ts-node/register/transpile-only scripts/test-terrain-tiles.ts",
    "test:collab": "node -r ts-node/register/transpile-only scripts/test-collaborations.ts",
    "db:query": "node -r ts-node/register/transpile-only scripts/db-query.ts",
    "seed:taxonomy": "node -r ts-node/register/transpile-only scripts/seed-taxonomy.ts",
    "rollup:analytics": "node -r ts-node/register/transpile-only scripts/rollup-analytics.ts",
    "seed": "ts-node scripts/seed-dev-data.ts",
    "db:seed": "ts-node scripts/seed-dev-data.ts",
    "generate-invite": "ts-node scripts/generate-invite.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "terrain",
    "3d-printing",
    "marketplace",
    "tabletop",
    "miniatures"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1077.0",
    "@aws-sdk/s3-request-presigner": "^3.1077.0",
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/extensions": "^4.4.1",
    "@gltf-transform/functions": "^4.4.1",
    "archiver": "^7.0.1",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "draco3dgltf": "^1.5.7",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "meshoptimizer": "^1.2.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.3",
    "rate-limit-redis": "^4.2.0",
    "redis": "^4.6.12",
    "resend": "^3.0.0",
    "stl-parser": "^0.11.1",
    "stripe": "^14.10.0",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.10.9",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "sharp": "^0.35.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
