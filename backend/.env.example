# ── Core ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
JWT_SECRET=change-me-to-a-32+char-secret
JWT_EXPIRES_IN=7d
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=104857600
EMAIL_FROM=noreply@example.com
FRONTEND_URL=http://localhost:3000
BASE_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Mock mode (no Postgres / Stripe needed) ────────────────────────────
DB_MOCK=true
STRIPE_MOCK=true
PAYMENTS_ENABLED=false

# ── Real mode ──────────────────────────────────────────────────────────
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ── Cloudflare R2 asset serving (optional; see R2_SETUP.md) ─────────────
# When all five are set, GLBs/thumbnails/textures are served from R2's CDN
# and uploads mirror to R2. Unset → assets served from this app's /uploads.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=artifact-armoury-assets
# R2_PUBLIC_BASE_URL=https://assets.yourdomain.com
